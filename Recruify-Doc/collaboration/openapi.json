  "components": {
    "schemas": {
      "ActiveUserInfo": {
        "properties": {
          "user_email": {
            "type": "string",
            "title": "User Email"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen At"
          },
          "is_you": {
            "type": "boolean",
            "title": "Is You"
          }
        },
        "type": "object",
        "required": [
          "user_email",
          "display_name",
          "context",
          "last_seen_at",
          "is_you"
        ],
        "title": "ActiveUserInfo"
      },
      "ActivityHeartbeat": {
        "properties": {
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "title": "ActivityHeartbeat"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ShareRequest": {
        "properties": {
          "share_with_email": {
            "type": "string",
            "title": "Share With Email"
          },
          "resource_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Name"
          }
        },
        "type": "object",
        "required": [
          "share_with_email"
        ],
        "title": "ShareRequest"
      },
      "ShareResourcePayload": {
        "properties": {
          "resource_type": {
            "type": "string",
            "title": "Resource Type"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "shared_by_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shared By Email",
            "default": ""
          },
          "shared_by_keycloak_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shared By Keycloak Id",
            "default": ""
          },
          "shared_with_email": {
            "type": "string",
            "title": "Shared With Email"
          },
          "shared_with_keycloak_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shared With Keycloak Id",
            "default": ""
          },
          "org_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id"
          }
        },
        "type": "object",
        "required": [
          "resource_type",
          "resource_id",
          "shared_with_email"
        ],
        "title": "ShareResourcePayload"
      },
      "ShareResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "resource_type": {
            "type": "string",
            "title": "Resource Type"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "shared_by_email": {
            "type": "string",
            "title": "Shared By Email"
          },
          "shared_with_email": {
            "type": "string",
            "title": "Shared With Email"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "resource_type",
          "resource_id",
          "shared_by_email",
          "shared_with_email"
        ],
        "title": "ShareResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
