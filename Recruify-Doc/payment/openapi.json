{
  "openapi": "3.1.0",
  "info": {
    "title": "Recruify - Payment Microservice",
    "description": "Autonomous microservice API for Payment webhooks and organization onboarding",
    "version": "v3"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Payment Microservice - Health"
        ],
        "summary": "Health Check",
        "description": "Service health check.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/payment/register": {
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Register new organization upon payment and activate subscription",
        "operationId": "register_organization_payment_register_post",
        "parameters": [
          {
            "name": "x-payment-secret",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Payment-Secret"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterOrganizationPaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Register Organization Payment Register Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/payment/subscription": {
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Renew or change subscription plan for an existing organization upon payment",
        "operationId": "update_subscription_payment_subscription_post",
        "parameters": [
          {
            "name": "x-payment-secret",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Payment-Secret"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Update Subscription Payment Subscription Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RegisterOrganizationPaymentRequest": {
        "properties": {
          "organization_name": {
            "type": "string",
            "title": "Organization Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "subscription_plan": {
            "type": "string",
            "title": "Subscription Plan",
            "default": "trial"
          },
          "subscription_start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscription Start Date"
          },
          "subscription_end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscription End Date"
          }
        },
        "type": "object",
        "required": [
          "organization_name",
          "email",
          "password"
        ],
        "title": "RegisterOrganizationPaymentRequest",
        "description": "Payload to register a new tenant organization upon successful payment."
      },
      "RenewSubscriptionRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "subscription_plan": {
            "type": "string",
            "title": "Subscription Plan"
          },
          "subscription_start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscription Start Date"
          },
          "subscription_end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscription End Date"
          }
        },
        "type": "object",
        "required": [
          "email",
          "subscription_plan"
        ],
        "title": "RenewSubscriptionRequest",
        "description": "Payload to renew or upgrade an existing organization's subscription."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}